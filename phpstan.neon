parameters:
	level: 8

	paths:
		- src
		- tests

	excludePaths:
		- tests/*/*.php

	ignoreErrors:
		-
			identifiers: [phpstanApi.method]
			path: src/Php/RemoveFailingReturnTypeExtension.php
		-
			identifiers: [phpstanApi.class, phpstanApi.method]
			path: src/Php/ClosureTypeCheckIgnoreExtension.php
		-
			identifiers: [phpstanApi.classConstant, phpstanApi.method]
			path: src/Tester/TypeAssert.php
		-
			identifiers: [phpstanApi.constructor]
			path: src/Utils/StringsReplaceClosureTypeExtension.php

includes:
	- extension.neon
