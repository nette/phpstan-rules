use:
	- nette
	- modernizations

paths:
	- src
	- tests

excludePaths:
	- tests/**/output

fileExtensions:
	- php
	- phpt

imports: {grouping: {class: grouped}}

overrides:
	-
		paths: [src]
		nameResolution: certain
		use:
			- compilerOptimizations
			- deprecations
	-
		paths: [tests/DI/compatibility-alias.php]
		upgrading: {api: keep}
